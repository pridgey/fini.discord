{
  "name": "fini.discord",
  "version": "1.0.0",
  "description": "Fini discord bot",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names \"pb,llama,bot\" \"./pocketbase serve\" \"llama serve -hf ggml-org/gemma-4-E2B-it-GGUF:Q8_0 --host 0.0.0.0 --port 8081 --mcp-servers-config mcp-servers.json\" \"bun --env-file=.env run index.ts\"",
    "delete-commands": "bun --env-file=.env run command_scripts/delete.ts",
    "register-commands": "bun --env-file=.env run command_scripts/register.ts",
    "set-bot-skin": "bun --env-file=.env run scripts/apply-bot-skin.ts",
    "set-bot-chat": "bun --env-file=.env run scripts/apply-bot-chat.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Taylor Pridgen",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@blockzilla101/citation": "^1.3.0",
    "@discordjs/builders": "^1.14.1",
    "@huggingface/transformers": "^4.3.1",
    "date-fns": "^3.6.0",
    "discord.js": "^14.27.0",
    "gif-encoder-2": "^1.0.5",
    "glob": "^10.5.0",
    "pocketbase": "^0.28.1",
    "rcon-client": "^4.2.5",
    "replicate": "^0.32.1",
    "seedrandom": "^3.0.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "concurrently": "^8.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@napi-rs/canvas": "0.1.59"
  }
}
