# Fini's in-game Minecraft bot: lifecycle, wandering and `hey fini` in chat.
#
# Install:
#   sudo cp services/systemd/fini-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fini-bot.service
#
# This is a copy of what should be installed at /etc/systemd/system. Keep the
# two in step - the monitor unit lived only on the host for months, which meant
# a rebuilt machine would have silently lost the empty-server shutdown.

[Unit]
Description=Fini Minecraft Bot
After=network.target

[Service]
Type=simple
User=pridgey
# Project root, so relative imports resolve
WorkingDirectory=/home/pridgey/Documents/Code/fini.discord
# Supplies MINECRAFT_RCON_PASS. Without it every RCON call fails
# indistinguishably from the server being down, and the service refuses to
# start rather than idling.
EnvironmentFile=/home/pridgey/Documents/Code/fini.discord/.env
ExecStart=/bin/bash -c 'source /home/pridgey/.bun/bin/bun-env.sh && bun run services/fini-bot.service.ts'
Restart=always
RestartSec=10
# The service exits non-zero when misconfigured, so cap the retries rather
# than looping every 10 seconds forever
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
